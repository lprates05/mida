# Server
PORT=3000
APP_ENV=local

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace_me
WHATSAPP_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me

# Supabase Postgres (use the direct connection string)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Feature flags
USE_LLM=false

# Optional LLM (OpenAI-compatible)
LLM_API_KEY=replace_me
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Human escalation
ESCALATION_KEYWORDS=human,agent,representative
